{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tfmc.local/planning/map-export-schema.json",
  "title": "TFMC map export extensions",
  "description": "Draft contract for SimpleFactions → ProvinceSystem map payloads. Nation upload remains the primary nation.json object; optional top-level keys extend the upload or ship as sidecar map_meta.json.",
  "type": "object",
  "properties": {
    "map_id": {
      "type": "string",
      "description": "Must match website mapId and SF mapRef (e.g. main, dev)"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "settlement_large_population_threshold": {
      "type": "integer",
      "description": "SF config: settlements with population greater than this export marker_size large (default 8)"
    },
    "global_wealth": {
      "type": "number",
      "description": "Optional server-wide wealth aggregate for charts"
    },
    "capitals": {
      "type": "array",
      "items": { "$ref": "#/$defs/settlement" }
    },
    "settlements": {
      "type": "array",
      "items": { "$ref": "#/$defs/settlement" }
    },
    "forts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fort" },
      "description": "Step 43 ZOC export — not used in step 54; use installations[] for map markers"
    },
    "installations": {
      "type": "array",
      "items": { "$ref": "#/$defs/installation" },
      "description": "Step 54: forts, ports, airports placed via /faction construct"
    },
    "wars": {
      "type": "array",
      "items": { "$ref": "#/$defs/war" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/chronicle_event" }
    }
  },
  "$defs": {
    "settlement": {
      "type": "object",
      "required": ["id", "name", "province_id", "faction_id", "kind"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Display name set in-game" },
        "province_id": { "type": "integer" },
        "faction_id": { "type": "string" },
        "guild_id": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["faction_capital", "guild_capital", "settlement"]
        },
        "center_x": {
          "type": "integer",
          "description": "Minecraft block X at founding (SF export)"
        },
        "center_z": {
          "type": "integer",
          "description": "Minecraft block Z at founding (SF export)"
        },
        "provinces": {
          "type": "array",
          "items": { "type": "integer" },
          "minItems": 1,
          "maxItems": 1,
          "description": "Single-province settlement territory — always [province_id] / [centerProvince]"
        },
        "population": {
          "type": "integer",
          "description": "Guild capitals in the settlement province (SF export)"
        },
        "marker_size": {
          "type": "string",
          "enum": ["small", "large"],
          "description": "Icon tier from SF population vs settlement_large_population_threshold"
        },
        "map_x": {
          "type": "integer",
          "description": "Pixel X on shared map grid (PS-served from province centroid)"
        },
        "map_y": {
          "type": "integer",
          "description": "Pixel Y on shared map grid (PS-served from province centroid)"
        }
      }
    },
    "fort": {
      "type": "object",
      "required": ["id", "name", "province_id", "faction_id", "zoc_provinces"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "province_id": { "type": "integer" },
        "faction_id": { "type": "string" },
        "zoc_provinces": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Fort province plus one-ring land neighbors owned by factions in the same top realm (step 43 ZOC)"
        },
        "center_x": {
          "type": "integer",
          "description": "Minecraft block X at construct (SF export)"
        },
        "center_z": {
          "type": "integer",
          "description": "Minecraft block Z at construct (SF export)"
        },
        "map_x": { "type": "integer" },
        "map_y": { "type": "integer" }
      }
    },
    "installation": {
      "type": "object",
      "required": ["id", "name", "kind", "province_id", "faction_id", "center_x", "center_z"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "description": "Display name set in-game (hex colour supported)" },
        "kind": {
          "type": "string",
          "enum": ["fort", "port", "airport"]
        },
        "province_id": { "type": "integer" },
        "faction_id": { "type": "string" },
        "center_x": {
          "type": "integer",
          "description": "Minecraft block X at construct (SF export)"
        },
        "center_z": {
          "type": "integer",
          "description": "Minecraft block Z at construct (SF export)"
        },
        "map_x": {
          "type": "integer",
          "description": "Pixel X on shared map grid (PS-served from center_x, 1:1)"
        },
        "map_y": {
          "type": "integer",
          "description": "Pixel Y on shared map grid (PS-served from center_z, 1:1)"
        }
      }
    },
    "war": {
      "type": "object",
      "required": ["id", "war_type", "goal", "status", "belligerents", "attacker_leader_id", "defender_leader_id"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "war_type": {
          "type": "string",
          "enum": ["de_jure", "subjugate", "transfer_subject", "raid"],
          "description": "Campaign shape; goal may further specify de_jure_annex vs subjugate"
        },
        "goal": {
          "type": "string",
          "enum": ["de_jure_annex", "subjugate", "transfer_subject"],
          "description": "One goal per war; raid wars use pillage outcome instead"
        },
        "status": { "type": "string", "enum": ["active", "ended"] },
        "attacker_leader_id": { "type": "string", "description": "Main attacker faction id (war leader)" },
        "defender_leader_id": { "type": "string", "description": "Main defender faction id (war leader)" },
        "belligerents": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "description": "All faction ids on either side (main, subjects, called allies)"
        },
        "objective_province_id": {
          "type": "integer",
          "description": "Single capture/recapture province for this war"
        },
        "target_title_id": {
          "type": "string",
          "description": "De jure title id when applicable"
        },
        "campaign_provinces": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Ordered campaign polyline province ids"
        },
        "cursor_index": {
          "type": "integer",
          "description": "Current index into campaign_provinces"
        },
        "initiative_attacker": { "type": "integer" },
        "initiative_defender": { "type": "integer" },
        "white_peace_proposed_by_attacker": {
          "type": "boolean",
          "description": "Attacker auto-proposed white peace (cannot reach capitulation target with remaining initiative)"
        },
        "white_peace_proposed_by_defender": {
          "type": "boolean",
          "description": "Defender auto-proposed white peace"
        },
        "occupied_by_attacker": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Provinces tinted as attacker-occupied (bulge front)"
        },
        "occupied_by_defender": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Provinces tinted as defender-occupied"
        },
        "last_battle_occupied": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Provinces added by the most recent battle"
        },
        "frontline_provinces": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "Deprecated alias; prefer occupied_* lists. Optional edge highlight."
        },
        "campaign_markers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "map_x", "map_y"],
            "properties": {
              "label": { "type": "string" },
              "map_x": { "type": "integer" },
              "map_y": { "type": "integer" },
              "province_id": { "type": "integer" }
            }
          }
        },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "end_reason": {
          "type": "string",
          "enum": [
            "attacker_goal",
            "defender_goal",
            "attacker_surrender",
            "defender_surrender",
            "white_peace",
            "auto_white_peace",
            "attacker_capital_lost",
            "defender_capital_lost",
            "raid_complete"
          ]
        }
      }
    },
    "chronicle_event": {
      "type": "object",
      "required": ["at", "type"],
      "properties": {
        "at": { "type": "string", "format": "date-time" },
        "type": {
          "type": "string",
          "enum": [
            "province_gained",
            "province_lost",
            "war_declared",
            "war_ended",
            "battle_scheduled",
            "battle_result",
            "province_occupied",
            "capital_moved",
            "fort_built",
            "fort_lost",
            "vassal_changed",
            "other"
          ]
        },
        "faction_id": { "type": "string" },
        "other_faction_id": { "type": "string" },
        "province_id": { "type": "integer" },
        "summary": { "type": "string", "description": "Human-readable one-liner for chronicle log" }
      }
    }
  }
}
